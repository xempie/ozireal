# Copy to .env.local and fill in.
DATABASE_URL=postgres://user@host:5432/ozirealty
AWS_REGION=ap-southeast-2

# Later phases
# REDIS_URL=redis://127.0.0.1:6379
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# DEEPGRAM_API_KEY=
# S3_BUCKET=

# Auth
# AUTH_SECRET=            # required in production
# AUTH_ALLOWED_EMAILS=sam@ozirealty.com.au
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_ENTRA_ID=
# AUTH_ENTRA_SECRET=
# AUTH_ENTRA_TENANT=
# AUTH_DEV_LOGIN=1        # local only, refused in production

# Intake (B3)
# REDIS_URL=redis://127.0.0.1:6379
# FORM_TOKEN_SECRET=        # signs the public form token; falls back to AUTH_SECRET
# INGEST_TEST_SECRET=       # dev/test only: lets tests hit /api/inbound/ses without SNS
# SES_TOPIC_ARN=            # required in production: the inbound-mail SNS topic
